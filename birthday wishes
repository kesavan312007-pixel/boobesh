<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Sastika ✨</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Cinzel:wght@500;700&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">

<style>
*{ margin:0; padding:0; box-sizing:border-box; }
html{ scroll-behavior:smooth; }
body{ background:#050505; overflow-x:hidden; font-family:'Poppins',sans-serif; color:white; }

/* ── BACKGROUND ── */
.background{ position:fixed; width:100%; height:100%; top:0; left:0; overflow:hidden; z-index:-3; }
.background video{ width:100%; height:100%; object-fit:cover; filter:brightness(0.35); }
.overlay{
  position:fixed; inset:0;
  background: radial-gradient(circle at top, rgba(255,105,180,0.15), transparent 40%), rgba(0,0,0,0.55);
  z-index:-2;
}

/* ── PARTICLES ── */
.particle{ position:fixed; width:4px; height:4px; border-radius:50%; background:white; opacity:0.7; pointer-events:none; animation:float linear infinite; z-index:-1; }
@keyframes float{ from{ transform:translateY(100vh) scale(0); } to{ transform:translateY(-10vh) scale(1.5); } }

/* ── CONFETTI ── */
.confetti-piece{
  position:fixed;
  width:10px; height:14px;
  top:-20px;
  pointer-events:none;
  z-index:9999;
  animation: confettiFall linear forwards;
  border-radius:2px;
}
@keyframes confettiFall{
  0%{ transform: translateY(0) rotate(0deg); opacity:1; }
  100%{ transform: translateY(110vh) rotate(720deg); opacity:0; }
}

/* ── MUSIC BTN ── */
#musicBtn{
  position:fixed; top:18px; right:18px;
  width:46px; height:46px;
  border-radius:50%; border:none;
  background:linear-gradient(135deg,#ff4da6,#ff80bf);
  color:white; font-size:1.3rem;
  cursor:pointer; z-index:200;
  box-shadow:0 0 18px rgba(255,77,166,0.5);
  transition:0.3s;
}
#musicBtn:hover{ transform:scale(1.12); box-shadow:0 0 30px rgba(255,77,166,0.8); }

/* ── PASSWORD GATE ── */
#passwordGate{
  position:fixed; inset:0;
  background:rgba(0,0,0,0.96);
  display:flex; justify-content:center; align-items:center;
  z-index:9000; padding:20px;
  backdrop-filter:blur(6px);
}
.gate-box{
  text-align:center;
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,105,180,0.3);
  backdrop-filter:blur(18px);
  border-radius:30px;
  padding:50px 40px;
  max-width:480px; width:100%;
  animation:popupAnim 0.6s ease;
}
.gate-box .lock-icon{ font-size:4rem; margin-bottom:15px; animation:pulse 2s infinite; }
@keyframes pulse{ 0%,100%{transform:scale(1);} 50%{transform:scale(1.1);} }
.gate-box h2{ font-family:'Cinzel',serif; color:#ff8dc7; font-size:1.8rem; margin-bottom:10px; }
.gate-box p{ color:#ccc; margin-bottom:30px; font-size:0.95rem; }

#passwordInput{
  width:100%;
  padding:15px 20px;
  border-radius:50px;
  border:2px solid rgba(255,105,180,0.4);
  background:rgba(255,255,255,0.07);
  color:white;
  font-size:1rem;
  text-align:center;
  outline:none;
  letter-spacing:4px;
  transition:0.3s;
  font-family:'Poppins',sans-serif;
}
#passwordInput:focus{ border-color:#ff4da6; box-shadow:0 0 20px rgba(255,77,166,0.3); }
#passwordInput::placeholder{ letter-spacing:1px; color:#aaa; }

#unlockBtn{
  margin-top:18px;
  padding:15px 40px;
  border:none; border-radius:50px;
  background:linear-gradient(135deg,#ff4da6,#ff80bf);
  color:white; font-size:1rem;
  cursor:pointer; transition:0.4s;
  box-shadow:0 0 25px rgba(255,77,166,0.4);
  width:100%;
}
#unlockBtn:hover{ transform:scale(1.04) translateY(-3px); box-shadow:0 0 40px rgba(255,77,166,0.7); }

#wrongMsg{
  margin-top:14px;
  color:#ff6b6b;
  font-size:0.9rem;
  display:none;
  animation:shake 0.4s ease;
}
@keyframes shake{
  0%,100%{transform:translateX(0);}
  25%{transform:translateX(-8px);}
  75%{transform:translateX(8px);}
}

.hint-text{ margin-top:14px; color:rgba(255,141,199,0.6); font-size:0.8rem; }

/* ── HERO ── */
.hero{ min-height:100vh; display:flex; justify-content:center; align-items:center; flex-direction:column; text-align:center; padding:20px; position:relative; }
.hero h1{ font-family:'Cinzel',serif; font-size:5rem; color:#ff8dc7; letter-spacing:4px; animation:glow 2s infinite alternate; }
@keyframes glow{
  from{ text-shadow:0 0 10px #ff5ca8; }
  to{ text-shadow:0 0 20px #ff5ca8, 0 0 50px #ff5ca8; }
}
.typing{ margin-top:25px; font-size:1.2rem; max-width:700px; line-height:2; color:#f5f5f5; }

/* ── COUNTDOWN ── */
.countdown-section{ margin-top:40px; text-align:center; }
.countdown-section p{ color:#ff8dc7; font-size:0.9rem; letter-spacing:1px; margin-bottom:12px; text-transform:uppercase; }
.countdown-boxes{ display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }
.cbox{
  background:rgba(255,255,255,0.07);
  border:1px solid rgba(255,105,180,0.3);
  border-radius:16px;
  padding:14px 20px;
  min-width:70px;
  text-align:center;
  backdrop-filter:blur(10px);
}
.cbox span{ display:block; font-size:2rem; font-weight:700; color:#ff8dc7; line-height:1; }
.cbox small{ font-size:0.65rem; color:#ccc; letter-spacing:1px; text-transform:uppercase; }

/* ── MAIN BTN ── */
.main-btn{
  margin-top:40px; padding:18px 45px; border:none; border-radius:60px;
  background:linear-gradient(135deg,#ff4da6,#ff80bf);
  color:white; font-size:1rem; cursor:pointer; transition:0.4s;
  box-shadow:0 0 25px rgba(255,77,166,0.4);
}
.main-btn:hover{ transform:scale(1.08) translateY(-5px); box-shadow:0 0 45px rgba(255,77,166,0.8); }

/* ── IMAGE SECTION ── */
.image-section{ padding:100px 20px; display:flex; justify-content:center; }
.image-box{
  width:320px; height:420px; border-radius:35px; overflow:hidden; position:relative;
  animation:floatImage 4s ease-in-out infinite; transition:0.5s;
  box-shadow:0 0 40px rgba(255,105,180,0.25);
}
.image-box img{ width:100%; height:100%; object-fit:cover; transition:0.5s; }
.image-box:hover{ transform:rotateY(10deg) rotateX(5deg) scale(1.05); box-shadow:0 0 60px rgba(255,105,180,0.65); }
.image-box:hover img{ transform:scale(1.1); }
@keyframes floatImage{ 50%{ transform:translateY(-18px); } }
.image-box::after{
  content:''; position:absolute; inset:-5px;
  background:linear-gradient(45deg,#ff4da6,transparent,#ff80bf);
  z-index:-1; border-radius:35px;
  animation:rotate 5s linear infinite;
}
@keyframes rotate{ 100%{ transform:rotate(360deg); } }

/* ── SURPRISES ── */
.surprises{ padding:120px 20px; text-align:center; }
.surprises h2{ font-size:3rem; margin-bottom:60px; font-family:'Cinzel',serif; color:#ff8dc7; }
.card-container{ display:flex; justify-content:center; gap:30px; flex-wrap:wrap; }
.card{
  width:300px; padding:35px; border-radius:30px;
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);
  backdrop-filter:blur(12px); transition:0.5s; cursor:pointer;
}
.card:hover{ transform:translateY(-10px) scale(1.03); box-shadow:0 0 35px rgba(255,105,180,0.4); }
.card span{ font-size:3rem; }
.card h3{ margin-top:20px; color:#ff8dc7; }
.card p{ margin-top:15px; line-height:1.9; color:#f3f3f3; }

/* ── WISH BOARD ── */
.wish-section{ padding:80px 20px; text-align:center; }
.wish-section h2{ font-family:'Cinzel',serif; color:#ff8dc7; font-size:2.5rem; margin-bottom:30px; }
.wish-input-row{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; max-width:600px; margin:0 auto 30px; }
#wishInput{
  flex:1; min-width:200px;
  padding:14px 20px; border-radius:50px;
  border:1.5px solid rgba(255,105,180,0.4);
  background:rgba(255,255,255,0.07);
  color:white; font-size:0.95rem; outline:none;
  font-family:'Poppins',sans-serif;
  transition:0.3s;
}
#wishInput:focus{ border-color:#ff4da6; box-shadow:0 0 15px rgba(255,77,166,0.3); }
#wishInput::placeholder{ color:#aaa; }
#sendWishBtn{
  padding:14px 28px; border:none; border-radius:50px;
  background:linear-gradient(135deg,#ff4da6,#ff80bf);
  color:white; font-size:0.95rem; cursor:pointer; transition:0.3s;
  box-shadow:0 0 18px rgba(255,77,166,0.4);
}
#sendWishBtn:hover{ transform:scale(1.05); }
#wishBoard{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; max-width:800px; margin:0 auto; }
.wish-bubble{
  background:rgba(255,77,166,0.15);
  border:1px solid rgba(255,105,180,0.3);
  border-radius:20px;
  padding:12px 20px;
  color:#f9d0e8;
  backdrop-filter:blur(8px);
  animation:popIn 0.4s ease;
  font-family:'Dancing Script',cursive;
  font-size:1.1rem;
}
@keyframes popIn{
  from{ transform:scale(0.5); opacity:0; }
  to{ transform:scale(1); opacity:1; }
}

/* ── POPUP ── */
.popup{
  position:fixed; inset:0;
  background:rgba(0,0,0,0.92);
  display:none; justify-content:center; align-items:center;
  z-index:100; padding:20px;
}
.popup-content{
  width:90%; max-width:700px; padding:45px; border-radius:35px;
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.1);
  backdrop-filter:blur(18px);
  position:relative; text-align:center;
  animation:popupAnim 0.6s ease;
}
@keyframes popupAnim{ from{opacity:0;transform:scale(0.7);} to{opacity:1;transform:scale(1);} }
.popup-content h2{ color:#ff8dc7; margin-bottom:25px; font-family:'Cinzel',serif; }
.popup-content p{ line-height:2; color:#f3f3f3; }
.close{
  position:absolute; top:15px; right:15px;
  width:42px; height:42px; border:none; border-radius:50%;
  background:#ff4da6; color:white; cursor:pointer;
  font-size:1rem;
}

/* ── FINAL ── */
.final{ padding:150px 20px; text-align:center; }
.final h2{ font-size:4rem; font-family:'Cinzel',serif; color:#ff8dc7; }
.final p{ margin-top:30px; max-width:800px; margin-inline:auto; line-height:2; font-size:1.1rem; color:#f0f0f0; }

/* ── STARS ── */
.star{
  position:fixed; pointer-events:none; z-index:9998;
  font-size:1.2rem;
  animation: starPop 1s ease forwards;
}
@keyframes starPop{
  0%{opacity:1; transform:scale(0) rotate(0deg);}
  50%{opacity:1; transform:scale(1.5) rotate(180deg);}
  100%{opacity:0; transform:scale(0.5) translateY(-60px) rotate(360deg);}
}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  .hero h1{ font-size:2.7rem; }
  .surprises h2{ font-size:2rem; }
  .final h2{ font-size:2.5rem; }
}

/* ── UNLOCK ANIMATION ── */
#unlockOverlay{
  position:fixed; inset:0;
  background:radial-gradient(circle, rgba(255,77,166,0.4), rgba(0,0,0,0.95));
  display:none; justify-content:center; align-items:center;
  z-index:8999;
  flex-direction:column; gap:20px;
  animation:fadeIn 0.4s ease;
}
@keyframes fadeIn{ from{opacity:0;} to{opacity:1;} }
.unlock-text{
  font-family:'Cinzel',serif;
  font-size:2.5rem;
  color:#ff8dc7;
  animation:glow 1s infinite alternate;
  text-align:center;
}
.unlock-emoji{ font-size:5rem; animation:bounce 0.6s infinite alternate; }
@keyframes bounce{ from{transform:translateY(0);} to{transform:translateY(-20px);} }
</style>
</head>

<body>

<!-- BACKGROUND -->
<div class="background">
  <video autoplay muted loop>
    <source src="https://cdn.coverr.co/videos/coverr-stars-in-the-night-sky-1560082116768?download=1080p" type="video/mp4">
  </video>
</div>
<div class="overlay"></div>

<!-- MUSIC BUTTON -->
<button id="musicBtn" onclick="toggleMusic()" title="Toggle Music">🎵</button>
<audio id="bgMusic" loop>
  <source src="https://www.bensound.com/bensound-music/bensound-romantic.mp3" type="audio/mpeg">
</audio>

<!-- PASSWORD GATE -->
<div id="passwordGate">
  <div class="gate-box">
    <div class="lock-icon">🔒</div>
    <h2>Secret Birthday Surprise</h2>
    <p>This is a special page made just for Sastika.<br>Enter the password to unlock the magic ✨</p>
    <input type="password" id="passwordInput" placeholder="Enter password..." maxlength="30" onkeydown="if(event.key==='Enter') checkPassword()">
    <button id="unlockBtn" onclick="checkPassword()">Unlock 🗝️</button>
    <div id="wrongMsg">❌ Wrong password! Try again 💔</div>
