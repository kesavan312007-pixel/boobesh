<!-- UNLOCK ANIMATION OVERLAY -->
<div id="unlockOverlay">
  <div class="unlock-emoji">🎉</div>
  <div class="unlock-text">Welcome, Sastika! 💖</div>
  <div class="unlock-text" style="font-size:1.2rem;font-family:'Poppins',sans-serif;color:#f0f0f0;">Your surprise is ready...</div>
</div>

<!-- MAIN CONTENT (hidden until unlocked) -->
<div id="mainContent" style="display:none;">

<!-- HERO -->
<section class="hero">
  <h1>Happy Birthday Sastika ✨</h1>
  <p class="typing" id="typing"></p>

  <!-- COUNTDOWN -->
  <div class="countdown-section">
    <p>⏳ Age counter since your birthday</p>
    <div class="countdown-boxes">
      <div class="cbox"><span id="cd-days">0</span><small>Days</small></div>
      <div class="cbox"><span id="cd-hours">0</span><small>Hours</small></div>
      <div class="cbox"><span id="cd-mins">0</span><small>Mins</small></div>
      <div class="cbox"><span id="cd-secs">0</span><small>Secs</small></div>
