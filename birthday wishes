</section>

<!-- IMAGE -->
<section class="image-section">
  <div class="image-box">
    <img src="C:\Users\kesavan\Downloads\sas 1.jpeg" alt="Sastika">
  </div>
</section>

<!-- SURPRISES -->
<section class="surprises" id="surprises">
  <h2>Choose Your Surprise 💖</h2>
  <div class="card-container">

    <div class="card" onclick="openPopup(1)">
      <span>💌</span>
      <h3>Secret Letter</h3>
      <p>A heartfelt message specially written for you ✨</p>
    </div>

    <div class="card" onclick="openPopup(2)">
      <span>📸</span>
      <h3>Memory Vault</h3>
      <p>The memories with you became unforgettable 🌙</p>
    </div>

    <div class="card" onclick="openPopup(3)">
      <span>🌸</span>
      <h3>One Last Thing</h3>
      <p>Something I always wanted to say 💕</p>
    </div>

  </div>
</section>

<!-- WISH BOARD -->
<section class="wish-section">
  <h2>Send Her a Wish 🌟</h2>
  <div class="wish-input-row">
    <input type="text" id="wishInput" placeholder="Write a birthday wish..." maxlength="80" onkeydown="if(event.key==='Enter') sendWish()">
    <button id="sendWishBtn" onclick="sendWish()">Send 💌</button>
  </div>
  <div id="wishBoard"></div>
</section>

<!-- POPUP -->
<div class="popup" id="popup">
  <div class="popup-content">
    <button class="close" onclick="closePopup()">✕</button>
    <div id="popupText"></div>
  </div>
</div>

<!-- FINAL -->
<section class="final">
  <h2>From Boobesh To Sastika 💖</h2>
  <p>
    Out of billions of people in this world,
    I'm really glad I met YOU ✨<br><br>
    Thank you for every smile,
    every conversation,
    and every beautiful memory 🌸<br><br>
    You accidentally became one of the
    most important people in my life 💕<br><br>
    Happy Birthday Sastika 🎂
  </p>
</section>

</div><!-- end mainContent -->

<script>

/* PASSWORD SYSTEM */
const CORRECT_PASSWORD = "sastika"; // 🔑 Change this to whatever you want!

function checkPassword(){
  const val = document.getElementById("passwordInput").value.trim().toLowerCase();
  const wrongMsg = document.getElementById("wrongMsg");

  if(val === CORRECT_PASSWORD){
    wrongMsg.style.display = "none";
    document.getElementById("passwordGate").style.display = "none";
    showUnlockAnimation();
  } else {
    wrongMsg.style.display = "block";
    wrongMsg.style.animation = "none";
    void wrongMsg.offsetWidth;
    wrongMsg.style.animation = "shake 0.4s ease";
    document.getElementById("passwordInput").value = "";
    const box = document.querySelector(".gate-box");
    box.style.animation = "none";
    void box.offsetWidth;
    box.style.animation = "shake 0.4s ease";
  }
}

function showUnlockAnimation(){
  const overlay = document.getElementById("unlockOverlay");
  overlay.style.display = "flex";
  triggerConfetti(120);
  setTimeout(()=>{
    overlay.style.opacity = "0";
    overlay.style.transition = "opacity 0.8s";
    setTimeout(()=>{
      overlay.style.display = "none";
      document.getElementById("mainContent").style.display = "block";
      startTyping();
      updateCountdown();
      setInterval(updateCountdown, 1000);
      triggerConfetti(60);
    }, 900);
  }, 2800);
}

/* CONFETTI */
const confettiColors = ["#ff4da6","#ff80bf","#ffcce6","#fff176","#80deea","#b39ddb","#ff8a65"];

function triggerConfetti(count){
  for(let i=0; i<count; i++){
    setTimeout(()=>{
      const c = document.createElement("div");
      c.classList.add("confetti-piece");
      c.style.left = Math.random()*100 + "vw";
      c.style.background = confettiColors[Math.floor(Math.random()*confettiColors.length)];
      c.style.animationDuration = (Math.random()*2+1.5) + "s";
      c.style.animationDelay = (Math.random()*0.5) + "s";
      c.style.transform = `rotate(${Math.random()*360}deg)`;
      document.body.appendChild(c);
      setTimeout(()=> c.remove(), 4000);
    }, i*30);
  }
}

/* STAR BURST ON CLICK */
const starEmojis = ["✨","⭐","🌟","💫","🎉","💖","🌸"];
document.addEventListener("click", e=>{
  if(e.target.closest("#passwordGate") || e.target.closest("#unlockOverlay")) return;
  const star = document.createElement("div");
  star.classList.add("star");
  star.textContent = starEmojis[Math.floor(Math.random()*starEmojis.length)];
  star.style.left = (e.pageX - 12) + "px";
  star.style.top  = (e.pageY - 12) + "px";
  document.body.appendChild(star);
  setTimeout(()=> star.remove(), 1000);
});

/* TYPING EFFECT */
const text = "From Boobesh to the most amazing bestie, Sastika 💖";
let i = 0;
function startTyping(){
  if(i < text.length){
    document.getElementById("typing").innerHTML += text.charAt(i);
    i++;
    setTimeout(startTyping, 50);
  }
}

/* FLOATING PARTICLES */
function createParticle(){
  const p = document.createElement("div");
  p.classList.add("particle");
  p.style.left = Math.random()*100 + "vw";
  p.style.animationDuration = Math.random()*5+4 + "s";
  p.style.opacity = Math.random();
  document.body.appendChild(p);
  setTimeout(()=> p.remove(), 9000);
}
setInterval(createParticle, 150);

/* MUSIC TOGGLE */
let musicPlaying = false;
function toggleMusic(){
  const music = document.getElementById("bgMusic");
  const btn   = document.getElementById("musicBtn");
  if(musicPlaying){
    music.pause();
    btn.textContent = "🎵";
    musicPlaying = false;
  } else {
    music.play().catch(()=>{});
    btn.textContent = "🔊";
    musicPlaying = true;
  }
}

/* COUNTDOWN */
function updateCountdown(){
  // ✏️ Change month (0=Jan,1=Feb...4=May) and day to her actual birthday!
  const birthday = new Date(new Date().getFullYear(), 4, 26); // May 25
  const now      = new Date();
  let diff = now - birthday;
  if(diff < 0){
    diff = birthday - now;
    document.querySelector(".countdown-section p").textContent = "⏳ Countdown to your birthday";
  } else {
    document.querySelector(".countdown-section p").textContent = "🎂 Time since your birthday today";
  }
  const totalSec = Math.floor(Math.abs(diff)/1000);
  const s = totalSec % 60;
  const m = Math.floor(totalSec/60) % 60;
  const h = Math.floor(totalSec/3600) % 24;
  const d = Math.floor(totalSec/86400);
  document.getElementById("cd-days").textContent  = String(d).padStart(2,"0");
  document.getElementById("cd-hours").textContent = String(h).padStart(2,"0");
  document.getElementById("cd-mins").textContent  = String(m).padStart(2,"0");
  document.getElementById("cd-secs").textContent  = String(s).padStart(2,"0");
}

/* SCROLL */
function scrollToSurprise(){
  document.getElementById("surprises").scrollIntoView({ behavior:"smooth" });
}

/* POPUPS */
function openPopup(type){
  const popup     = document.getElementById("popup");
  const popupText = document.getElementById("popupText");
  popup.style.display = "flex";

  if(type===1){
    popupText.innerHTML = `
      <h2>💌 Secret Letter</h2>
      <p>
        Dear Sastika ✨<br><br>
        Happy Birthday to the most beautiful soul 💖<br><br>
        Thank you for every laugh, every conversation,
        and every memory we created together 🌸<br><br>
        You genuinely make life brighter
        just by being yourself 🌙
      </p>`;
  } else if(type===2){
    popupText.innerHTML = `
      <h2>📸 Memory Vault</h2>
      <p>
        The random laughs, silly moments,
        and conversations with you
        somehow became my favorite memories 💕<br><br>
        Some people become special unexpectedly ✨
      </p>`;
  } else {
    popupText.innerHTML = `
      <h2>🌸 One Last Thing...</h2>
      <p>
        Out of everyone in this world,
        I'm really happy I met YOU 💖<br><br>
        Never stop smiling,
        never stop being yourself,
        because you are genuinely amazing ✨
      </p>`;
  }
  triggerConfetti(30);
}

function closePopup(){
  document.getElementById("popup").style.display = "none";
}

/* WISH BOARD */
function sendWish(){
  const input = document.getElementById("wishInput");
  const text  = input.value.trim();
  if(!text) return;
  const board  = document.getElementById("wishBoard");
  const bubble = document.createElement("div");
  bubble.classList.add("wish-bubble");
  bubble.textContent = "💖 " + text;
  board.appendChild(bubble);
  input.value = "";
  triggerConfetti(20);
}

/* 3D IMAGE MOVEMENT */
const imageBox = document.querySelector(".image-box");
document.addEventListener("mousemove", e=>{
  const x = (window.innerWidth/2  - e.pageX) / 30;
  const y = (window.innerHeight/2 - e.pageY) / 30;
  if(imageBox) imageBox.style.transform = `rotateY(${x}deg) rotateX(${-y}deg)`;
});

</script>
